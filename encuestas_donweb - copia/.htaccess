<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /encuestas/

  # ── API Routing ──────────────────────────────────────────────────────────
  # Si la URL comienza con api/, redirigir a api/api.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^api/(.*)$ api/api.php [L,QSA]

  # ── SPA (Single Page Application) ────────────────────────────────────────
  # No reescribir index.html ni archivos existentes
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /encuestas/index.html [L]
</IfModule>

# ── Cache Control ────────────────────────────────────────────────────────
# Deshabilitar caché para páginas HTML y la API
<FilesMatch "\.(html|php)$">
  Header always set Cache-Control "no-cache, no-store, must-revalidate, private"
  Header always set Pragma "no-cache"
  Header always set Expires "0"
</FilesMatch>

# Cache largo para assets con hash (JS/CSS con huella digital)
<FilesMatch "\.(js|css)$">
  Header set Cache-Control "public, immutable, max-age=31536000"
</FilesMatch>

# Cache moderado para imágenes y fuentes (1 semana)
<FilesMatch "\.(ico|jpg|jpeg|png|gif|svg|webp|woff|woff2|ttf|eot)$">
  Header set Cache-Control "public, max-age=604800"
</FilesMatch>

# ── Seguridad ─────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── Compresión ────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>
